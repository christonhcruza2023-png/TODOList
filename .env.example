# ---- TaskFlow server configuration ----
# Copy this file to ".env" in the project root and adjust the values.

# MongoDB connection string (local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/taskflow_db

# Port the Express API listens on
PORT=5000

# development | production | test
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API in production
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173
