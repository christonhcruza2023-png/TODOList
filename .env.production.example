# ---- ToDoList production configuration ----
# Template for the environment variables your host needs. Set these in the
# host's dashboard (Render, Railway, Fly, etc.) — never commit real values.
# A real .env.production is git-ignored.

# MongoDB Atlas connection string, including the database name before the "?".
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/todolist_db?retryWrites=true&w=majority
MONGO_URI=

# Turns on the CORS allowlist and production error handling.
NODE_ENV=production

# The exact public URL of the deployment, with https and no trailing slash.
# Browsers send an Origin header on same-origin POST/PUT/DELETE requests, and
# production CORS checks that Origin against this list, so a mismatch makes the
# app's own forms return 403. List several origins comma-separated if needed.
CLIENT_ORIGIN=https://your-app.onrender.com

# Most hosts inject PORT automatically and server.js reads it — leave unset
# unless your host requires an explicit port.
# PORT=10000
